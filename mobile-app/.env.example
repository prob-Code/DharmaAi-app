# DharmaAI Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit the .env file to git!

# Production backend. Override this for local development.
EXPO_PUBLIC_BACKEND_URL=https://dharmaai-app-blgs.onrender.com

# Sarvam TTS is called by the backend. Set SARVAM_API_KEY in
# mobile-app/backend/.env; do not put that secret in Expo public variables.

# Chat model (AWS Lambda Function URL)
EXPO_PUBLIC_CHAT_API_URL=https://lht7s7xvklyxrd46xwgi22x23i0ofhyn.lambda-url.ap-south-1.on.aws/
# Only if your Lambda requires an API key header; leave blank if it's open
EXPO_PUBLIC_CHAT_API_KEY=
# Optional fallback if Lambda is down
EXPO_PUBLIC_CHAT_FALLBACK_URL=https://agentcrafter-rag-gita.hf.space/chat

# Firebase web configuration (public client values; restrict API keys in Google Cloud)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: use the backend proxy for YouTube search. Leave blank to use the
# offline curated library only.
EXPO_PUBLIC_YOUTUBE_API_KEY=AIzaSyAJPpOLselgM8gmZ_q3WrwQB6VKsEeBJ8o
