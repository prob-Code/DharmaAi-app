# DharmaAI Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit the .env file to git!

EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_STRESS_API_KEY=your_stress_api_key_here
EXPO_PUBLIC_STRESS_API_URL=https://agentcrafter-dharmaai-stress-analyzer.hf.space
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000

# Used client-side by the Videos tab (Google YouTube Data API v3).
# Placeholder only — set the real key in EAS secrets; restrict the key in the
# Google Cloud console to your app/domain.
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase client project — URL and anon (publishable) key. Safe to ship to
# the client; the anon key is supplied via environment so the production
# project can be targeted without editing source.
# Production project (canonical): https://jktogziuyuazyzkbruhp.supabase.co
# REQUIRED for production/release builds — there is NO production fallback.
# If either var is missing in a release build, the app refuses to start
# (fail-closed) rather than silently connecting to the dev project.
# In development builds only, missing vars fall back to the legacy dev project.
EXPO_PUBLIC_SUPABASE_URL=https://jktogziuyuazyzkbruhp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
