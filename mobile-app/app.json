{
  "expo": {
    "name": "Saarthi",
    "slug": "dharmaai-inner-balance",
    "version": "1.0.0",
    "scheme": "dharmaai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-notifications",
      "expo-status-bar",
      "expo-audio",
      "expo-video",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dharmaai.innerbalance",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121C1A"
      },
      "package": "com.dharmaai.innerbalance",
      "versionCode": 6,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "dharmaai",
              "host": "auth-callback"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a39dc81e-85d7-4b87-a718-40d3eb49f322"
      }
    }
  }
}
