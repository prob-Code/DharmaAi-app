{
  "expo": {
    "name": "Saarthi",
    "slug": "dharmaai-inner-balance",
    "version": "1.0.0",
    "scheme": "dharmaai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-notifications",
      "expo-status-bar",
      "expo-audio",
      "expo-video",
      "expo-asset",
      "@react-native-google-signin/google-signin",
      [
        "@videosdk.live/expo-config-plugin",
        {
          "cameraPermission": "Allow Saarthi to use the camera for video calls",
          "microphonePermission": "Allow Saarthi to use the microphone for calls"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dharmaai.innerbalance",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "Saarthi uses the camera for video calls with your Dharma Circle.",
        "NSMicrophoneUsageDescription": "Saarthi uses the microphone for voice and video calls with your Dharma Circle."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121C1A"
      },
      "package": "com.dharmaai.innerbalance",
      "versionCode": 7,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "dharmaai",
              "host": "auth-callback"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "304f9ed0-37da-49cd-9205-abb3e0db4de0"
      }
    },
    "owner": "ojass_135"
  }
}
