# DharmaAI Backend — copy to `.env` and fill in real values (never commit `.env`)

# --- Runtime ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins, or * for all. In production set the
# exact mobile/browser origin that may call this API.
CORS_ORIGIN=*

# --- Supabase (server-side; validates bearer tokens on protected routes) ---
# Only the publishable anon key is used for validation.
# NEVER configure the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Providers (server-side only — never ship these to the mobile app) ---
# Required for POST /api/ai/stt and POST /api/ai/tts
SARVAM_API_KEY=
# Optional: only needed for POST /api/ai/chat
OPENROUTER_API_KEY=
# Optional: only needed for GET /api/youtube/search
YOUTUBE_API_KEY=